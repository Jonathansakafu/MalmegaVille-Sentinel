<Window x:Class="MalmegaVille.Sentinel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MalmegaVille Sentinel" Height="520" Width="840"
        Background="#050805"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0B0F0B" />
        <SolidColorBrush x:Key="BorderBrush2" Color="#2A332A" />
        <SolidColorBrush x:Key="BrandGreenBrush" Color="#7ED957" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A3ADA3" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7F5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="#F5F7F5" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandGreenBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#050805" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#050805" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#050805" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/logo.jpeg" Width="64" Height="64" Margin="0,0,12,0" />
            <TextBlock Text="MalmegaVille Sentinel" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}">
            <TabItem Header="Dashboard">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Sync Now" Width="120" Click="SyncNow_Click" Background="{StaticResource BrandGreenBrush}" Foreground="#050805" FontWeight="Bold" />
                        <Button Content="Refresh Queue" Width="120" Margin="8,0,0,0" Click="RefreshQueue_Click" />
                        <TextBlock x:Name="QueueStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <GroupBox Header="Queued Events" Grid.Row="1">
                        <Grid>
                            <ListBox x:Name="QueuedEventsList" BorderThickness="0" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Notification Settings">
                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Left" Width="440">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock x:Name="AccountStatusText" VerticalAlignment="Center" Text="Not signed in." />
                        <Button x:Name="SignInButton" Content="Sign In" Width="90" Margin="12,0,0,0" Click="SignIn_Click" Background="{StaticResource BrandGreenBrush}" Foreground="#050805" FontWeight="Bold" />
                        <Button x:Name="SignOutButton" Content="Sign Out" Width="90" Margin="8,0,0,0" Click="SignOut_Click" Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock Text="Every channel filled in below is used for alerts at the same time - fill in one or both."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="Alert email address" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="AlertEmailTextBox" Margin="0,0,0,16" IsEnabled="False" />

                    <TextBlock Text="Telegram bot token" FontWeight="Bold" Margin="0,0,0,4" />
                    <PasswordBox x:Name="TelegramBotTokenBox" Margin="0,0,0,4" IsEnabled="False" />
                    <TextBlock Text="Create a bot via @BotFather on Telegram to get a token." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <TextBlock Text="Telegram chat ID" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="TelegramChatIdTextBox" Margin="0,0,0,4" IsEnabled="False" />
                    <TextBlock Text="Message your bot, then open https://api.telegram.org/bot&lt;token&gt;/getUpdates to find your chat id." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="SaveSettingsButton" Content="Save Settings" Width="120" Click="SaveSettings_Click" IsEnabled="False" Background="{StaticResource BrandGreenBrush}" Foreground="#050805" FontWeight="Bold" />
                        <Button x:Name="SendTestAlertButton" Content="Send Test Alert" Width="130" Margin="8,0,0,0" Click="SendTestAlert_Click" IsEnabled="False" />
                    </StackPanel>

                    <TextBlock x:Name="SettingsStatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
