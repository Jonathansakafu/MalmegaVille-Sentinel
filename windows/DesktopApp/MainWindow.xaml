<Window x:Class="MalmegaVille.Sentinel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MalmegaVille Sentinel" Height="640" Width="960"
        MinHeight="560" MinWidth="820"
        Background="{StaticResource BackgroundBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,20">
            <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                <Image Source="pack://application:,,,/Assets/logo.jpeg" Width="56" Height="56" Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,56,56" RadiusX="14" RadiusY="14" />
                    </Image.Clip>
                </Image>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MalmegaVille Sentinel" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Endpoint security agent" Style="{StaticResource HintText}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Sync" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="Force an immediate sync of queued security events with the dashboard." Style="{StaticResource HintText}" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Sync Now" Width="130" Click="SyncNow_Click" Style="{StaticResource PrimaryButton}" />
                                    <Button Content="Refresh Queue" Width="130" Margin="10,0,0,0" Click="RefreshQueue_Click" Style="{StaticResource SecondaryButton}" />
                                    <TextBlock x:Name="QueueStatusText" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="This device" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="Registers this PC to your account so it appears in Device Inventory on the dashboard." Style="{StaticResource HintText}" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RegisterDeviceButton" Content="Register This PC" Width="150" Click="RegisterDevice_Click" Style="{StaticResource PrimaryButton}" />
                                    <TextBlock x:Name="DeviceStatusText" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource HintText}" MaxWidth="420" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Queued Events" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="Security events captured locally, pending or already synced to the dashboard." Style="{StaticResource HintText}" Margin="0,0,0,14" />
                                <ListBox x:Name="QueuedEventsList" MaxHeight="260" ScrollViewer.CanContentScroll="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notification Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Account" Style="{StaticResource SectionHeading}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse x:Name="AccountStatusDot" Width="10" Height="10" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AccountStatusText" VerticalAlignment="Center" Margin="10,0,0,0" Text="Not signed in." FontWeight="SemiBold" />
                                    <Button x:Name="SignInButton" Content="Sign In" Width="96" Margin="16,0,0,0" Click="SignIn_Click" Style="{StaticResource PrimaryButton}" />
                                    <Button x:Name="SignOutButton" Content="Sign Out" Width="96" Margin="10,0,0,0" Click="SignOut_Click" Visibility="Collapsed" Style="{StaticResource DangerButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Notification Channels" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="Every channel filled in below is used for alerts at the same time - fill in one or both." Style="{StaticResource HintText}" Margin="0,0,0,18" />

                                <TextBlock Text="Alert email address" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AlertEmailTextBox" Margin="0,0,0,16" IsEnabled="False" />

                                <TextBlock Text="Telegram bot token" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="TelegramBotTokenBox" Margin="0,0,0,6" IsEnabled="False" />
                                <TextBlock Text="Create a bot via @BotFather on Telegram to get a token." Style="{StaticResource HintText}" Margin="0,0,0,16" />

                                <TextBlock Text="Telegram chat ID" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TelegramChatIdTextBox" Margin="0,0,0,6" IsEnabled="False" />
                                <TextBlock Text="Message your bot, then open https://api.telegram.org/bot&lt;token&gt;/getUpdates to find your chat id." Style="{StaticResource HintText}" Margin="0,0,0,18" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="SaveSettingsButton" Content="Save Settings" Width="130" Click="SaveSettings_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" />
                                    <Button x:Name="SendTestAlertButton" Content="Send Test Alert" Width="140" Margin="10,0,0,0" Click="SendTestAlert_Click" IsEnabled="False" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>

                                <TextBlock x:Name="SettingsStatusText" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
