<Window x:Class="MalmegaVille.Sentinel.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in - MalmegaVille Sentinel" Height="360" Width="380"
        Background="#050805"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush2" Color="#2A332A" />
        <SolidColorBrush x:Key="BrandGreenBrush" Color="#7ED957" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7F5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B0F0B" />
            <Setter Property="Foreground" Value="#F5F7F5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0B0F0B" />
            <Setter Property="Foreground" Value="#F5F7F5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0B0F0B" />
            <Setter Property="Foreground" Value="#F5F7F5" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandGreenBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <Image Source="pack://application:,,,/Assets/logo.jpeg" Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center" />
        <TextBlock Text="Sign in to MalmegaVille Sentinel" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" HorizontalAlignment="Center" />

        <TextBlock Text="Email" Margin="0,0,0,4" />
        <TextBox x:Name="EmailTextBox" Margin="0,0,0,12" />

        <TextBlock Text="Password" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordInputBox" Margin="0,0,0,16" />

        <TextBlock x:Name="ErrorText" Foreground="#FB7185" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Click="Cancel_Click" IsCancel="True" />
            <Button x:Name="LoginButton" Content="Sign In" Width="80" Margin="8,0,0,0" Click="Login_Click" IsDefault="True" Background="{StaticResource BrandGreenBrush}" Foreground="#050805" FontWeight="Bold" />
        </StackPanel>
    </StackPanel>
</Window>
