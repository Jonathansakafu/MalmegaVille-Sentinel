<Window x:Class="MalmegaVille.Sentinel.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in - MalmegaVille Sentinel" Height="440" Width="400"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Image Source="pack://application:,,,/Assets/logo.jpeg" Width="72" Height="72" Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,72,72" RadiusX="18" RadiusY="18" />
                    </Image.Clip>
                </Image>
            </Border>
            <TextBlock Text="Sign in to MalmegaVille Sentinel" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Use the same account you use on the web dashboard." Style="{StaticResource HintText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" />

            <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="EmailTextBox" Margin="0,0,0,14" />

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordInputBox" Margin="0,0,0,14" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource RoseBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Click="Cancel_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" />
                <Button x:Name="LoginButton" Content="Sign In" Width="90" Margin="10,0,0,0" Click="Login_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
