## Example environment file for MalmegaVille Sentinel backend
# Copy this file to .env and replace placeholders with real values

PORT=4000

# Required for startup
MONGODB_URI=mongodb://localhost:27017/malmegaville
JWT_SECRET=change-me-to-a-strong-secret

# Set to true to run the backend without connecting to MongoDB (useful for quick testing)
# DBLESS_TEST_MODE=true

# Notification channels
# Both channels are used at once for every alert when configured — leave either
# block blank to disable that channel. At least one channel must be configured
# or alerts will only be logged, not delivered.

# Email - two options, checked in this order:
#
# 1) RESEND_API_KEY (recommended for hosted deployments): sends via Resend's HTTP
#    API (port 443) instead of SMTP. Needed because raw SMTP (ports 587/465) is
#    blocked outbound on some PaaS hosts, Railway included. Get a free key at
#    resend.com. Without your own verified sending domain, EMAIL_FROM must use
#    Resend's shared testing address: "MalmegaVille Sentinel <onboarding@resend.dev>".
RESEND_API_KEY=
#
# 2) Gmail SMTP (works for local dev; create a Gmail App Password for EMAIL_PASS).
#    Ignored if RESEND_API_KEY is set.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail.address@gmail.com
EMAIL_PASS=YOUR_APP_PASSWORD
EMAIL_FROM="MalmegaVille Sentinel <no-reply@malmegaville.local>"
ALERT_EMAIL_RECIPIENT=jonathansakafu@gmail.com
EMAIL_SECURE=false

# Telegram bot (create a bot via @BotFather, then message it and read the chat id
# from https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of the web dashboard - linked (with logo) in every alert email.
# Defaults to the local dev frontend; set to your Railway/production URL once deployed.
DASHBOARD_URL=http://localhost:5173

# Optional branding shown in email alerts - defaults to ${DASHBOARD_URL}/logo.jpeg
NOTIFICATION_LOGO_URL=

# Optional sync token used by the desktop agent when posting events
SYNC_TOKEN=

# Lost/stolen device capture storage (webcam photos + copied USB files)
# CAPTURE_STORAGE_DIR defaults to ./capture-storage if unset
CAPTURE_STORAGE_DIR=
CAPTURE_MAX_FILE_BYTES=26214400
CAPTURE_MAX_SESSION_BYTES=524288000

# Location capture fallback: when the desktop agent can't get a Wi-Fi based
# location fix, the backend resolves an approximate location from the
# device's public IP by calling this third-party, no-API-key-required
# service. Set IP_GEOLOCATION_ENABLED=false to disable this outbound call
# entirely (location capture will then only work when Wi-Fi positioning
# succeeds on the device).
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_URL=http://ip-api.com/json
