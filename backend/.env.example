## Example environment file for MalmegaVille Sentinel backend
# Copy this file to .env and replace placeholders with real values

# Required for startup
MONGODB_URI=mongodb://localhost:27017/malmegaville
JWT_SECRET=change-me-to-a-strong-secret

# Notification settings
NOTIFICATION_MODE=email

# Set to true to run the backend without connecting to MongoDB (useful for quick email testing)
# DBLESS_TEST_MODE=true

# Gmail SMTP (recommended: create a Gmail App Password and put it in EMAIL_PASS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail.address@gmail.com
EMAIL_PASS=YOUR_APP_PASSWORD
EMAIL_FROM="MalmegaVille Sentinel <no-reply@malmegaville.local>"
ALERT_EMAIL_RECIPIENT=jonathansakafu@gmail.com
EMAIL_SECURE=false

# Optional sync token used by the service when posting events
SYNC_TOKEN=
PORT=4000
MONGODB_URI=mongodb://localhost:27017/spyguard
JWT_SECRET=replace-with-strong-secret
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
